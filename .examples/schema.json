{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/post.schema.json",
  "type": "object",
  "required": ["title", "date"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "format": "date" },
    "tags": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
